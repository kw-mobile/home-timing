<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/ht_background"/>
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp"/>
            <stroke android:width="1dp" android:color="@color/ht_sheet_edge"/>
        </shape>
    </item>
    <!-- Cover lower edges: the outline belongs only to the rounded top boundary. -->
    <item android:top="24dp">
        <shape><solid android:color="@color/ht_background"/></shape>
    </item>
</layer-list>
