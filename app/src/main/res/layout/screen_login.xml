<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/preview_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/page_body" android:paddingHorizontal="@dimen/ht_screen_gutter" android:paddingTop="20dp" android:paddingBottom="@dimen/ht_space_32">
        <Space android:layout_width="1dp" android:layout_height="30dp"/>
        <androidx.appcompat.widget.AppCompatImageView android:layout_width="52dp" android:layout_height="52dp" android:importantForAccessibility="no" app:srcCompat="@drawable/ic_brand" app:tint="@color/ht_text"/>
        <Space android:layout_width="1dp" android:layout_height="@dimen/ht_space_24"/>
        <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/design_033" android:textAppearance="@style/TextAppearance.HomeTiming.Display"/>
        <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/design_034" android:textAppearance="@style/TextAppearance.HomeTiming.Label" android:layout_marginTop="@dimen/ht_space_12"/>
        <Space android:layout_width="1dp" android:layout_height="@dimen/ht_space_12"/>
        <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/design_035" android:textAppearance="@style/TextAppearance.HomeTiming.Label" android:layout_marginTop="20dp" android:labelFor="@id/auth_email"/>
        <androidx.appcompat.widget.AppCompatEditText android:id="@+id/auth_email" style="@style/Widget.HomeTiming.Field" android:hint="@string/design_036" android:inputType="textEmailAddress" android:imeOptions="actionNext"/>
        <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/design_017" android:textAppearance="@style/TextAppearance.HomeTiming.Caption" android:id="@+id/auth_email_error" android:visibility="gone" android:textColor="@color/ht_error" android:layout_marginTop="6dp"/>
        <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/design_037" android:textAppearance="@style/TextAppearance.HomeTiming.Label" android:layout_marginTop="20dp" android:labelFor="@id/auth_password"/>
        <androidx.appcompat.widget.AppCompatEditText android:id="@+id/auth_password" style="@style/Widget.HomeTiming.Field" android:hint="@string/design_037" android:inputType="textPassword" android:imeOptions="actionNext"/>
        <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/design_017" android:textAppearance="@style/TextAppearance.HomeTiming.Caption" android:id="@+id/auth_password_error" android:visibility="gone" android:textColor="@color/ht_error" android:layout_marginTop="6dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/auth_options"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/auth_submit" style="@style/Widget.HomeTiming.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/design_038" android:layout_marginTop="@dimen/ht_space_12"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/auth_switch" style="@style/Widget.HomeTiming.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/design_039" android:layout_marginTop="@dimen/ht_space_12"/>
        <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/design_040" android:textAppearance="@style/TextAppearance.HomeTiming.Caption" android:layout_marginTop="@dimen/ht_space_24" android:gravity="center"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
