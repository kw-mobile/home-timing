<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ocr_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:focusableInTouchMode="true"
        android:paddingHorizontal="@dimen/ht_screen_gutter" android:paddingTop="8dp" android:paddingBottom="32dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/ocr_back" android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/design_001" app:srcCompat="@drawable/ic_back" app:tint="@color/ht_text" />
            <com.google.android.material.textview.MaterialTextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="8dp" android:text="@string/ocr_title" android:textAppearance="@style/TextAppearance.HomeTiming.Brand" android:id="@+id/feature_heading" />
        </LinearLayout>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/ocr_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp"  android:textAppearance="@style/TextAppearance.HomeTiming.Label" android:accessibilityLiveRegion="polite" />
        <FrameLayout android:id="@+id/ocr_camera_box" android:layout_width="match_parent" android:layout_height="240dp" android:layout_marginTop="16dp">
            <androidx.camera.view.PreviewView android:id="@+id/ocr_preview" android:layout_width="match_parent" android:layout_height="match_parent" />
            <View android:layout_width="match_parent" android:layout_height="150dp" android:layout_margin="24dp" android:layout_gravity="center" android:background="@drawable/ocr_guide_border" android:importantForAccessibility="no" />
        </FrameLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/ocr_shutter" style="@style/Widget.HomeTiming.Button"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ocr_shutter" />
        <LinearLayout android:id="@+id/ocr_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <com.google.android.material.textview.MaterialTextView android:id="@+id/ocr_old_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"  android:textAppearance="@style/TextAppearance.HomeTiming.Caption"  />
            <LinearLayout android:id="@+id/ocr_candidates" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
        <com.google.android.material.textview.MaterialTextView  android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/ocr_name_label" android:textAppearance="@style/TextAppearance.HomeTiming.Label" android:labelFor="@id/ocr_name" />
            <androidx.appcompat.widget.AppCompatEditText android:id="@+id/ocr_name" style="@style/Widget.HomeTiming.Field" android:inputType="text" android:maxLength="60" android:hint="@string/ocr_name_label" />
        <com.google.android.material.textview.MaterialTextView  android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/ocr_confirm_help" android:textAppearance="@style/TextAppearance.HomeTiming.Caption"  />
        <com.google.android.material.button.MaterialButton android:id="@+id/ocr_apply" style="@style/Widget.HomeTiming.Button"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/ocr_apply" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/ocr_retry" style="@style/Widget.HomeTiming.Button.Secondary"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ocr_retry" />
        <com.google.android.material.button.MaterialButton android:id="@+id/ocr_cancel" style="@style/Widget.HomeTiming.TextButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ocr_manual" />
    </LinearLayout>
</ScrollView>
