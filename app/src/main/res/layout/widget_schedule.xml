<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingVertical="12dp"
    android:background="@drawable/bg_schedule_widget">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="24dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <android.widget.TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/widget_heading" android:textSize="13sp" android:fontFamily="@font/pretendard_medium"
            android:textColor="@color/ht_text_secondary" />
        <android.widget.TextView android:id="@+id/widget_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="13sp" android:fontFamily="@font/pretendard_medium" android:textColor="@color/ht_text_secondary" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <android.widget.TextView android:id="@+id/widget_message" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center_vertical" android:text="@string/widget_sign_in" android:textSize="15sp"
            android:fontFamily="@font/pretendard" android:textColor="@color/ht_text_secondary" />
    </FrameLayout>
    <android.widget.TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="16dp"
        android:gravity="center_vertical" android:textSize="12sp" android:fontFamily="@font/pretendard"
        android:textColor="@color/ht_text_secondary" />
</LinearLayout>
