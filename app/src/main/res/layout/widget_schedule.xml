<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingVertical="8dp"
    android:background="@drawable/bg_schedule_widget">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_ripple">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_brand"
            android:tint="@color/ht_text" tools:ignore="UseAppTint" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:text="@string/app_name" android:textSize="17sp"
            android:fontFamily="@font/pretendard_semibold" android:textColor="@color/ht_text" />
        <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="13sp" android:fontFamily="@font/pretendard" android:textColor="@color/ht_text_secondary" />
    </LinearLayout>
    <TextView android:id="@+id/widget_message" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical" android:text="@string/widget_sign_in"
        android:textSize="15sp" android:fontFamily="@font/pretendard" android:textColor="@color/ht_text_secondary"
        android:background="@drawable/widget_ripple" />
    <LinearLayout android:id="@+id/widget_days" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="@string/widget_today"
                android:textSize="15sp" android:fontFamily="@font/pretendard_semibold" android:textColor="@color/ht_text" />
            <LinearLayout android:id="@+id/widget_today_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ht_divider" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingTop="8dp">
            <TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="@string/widget_tomorrow"
                android:textSize="15sp" android:fontFamily="@font/pretendard_semibold" android:textColor="@color/ht_text" />
            <LinearLayout android:id="@+id/widget_tomorrow_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="20dp"
        android:gravity="bottom|start" android:paddingBottom="4dp" android:textSize="13sp"
        android:fontFamily="@font/pretendard" android:textColor="@color/ht_text_secondary" android:background="@drawable/widget_ripple" />
</LinearLayout>
