<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/update_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/update_back" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/design_001" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/update_title" android:textAppearance="@style/TextAppearance.HomeTiming.Brand" />
        <TextView android:id="@+id/update_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textAppearance="@style/TextAppearance.HomeTiming.Body" />
        <TextView android:id="@+id/update_target" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.HomeTiming.Body" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/update_help" android:textAppearance="@style/TextAppearance.HomeTiming.Body" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/update_auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="24dp" android:text="@string/update_auto" />
        <TextView android:id="@+id/update_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:accessibilityLiveRegion="polite" android:textAppearance="@style/TextAppearance.HomeTiming.Body" />
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/update_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="24dp" android:max="100" />
        <com.google.android.material.button.MaterialButton android:id="@+id/update_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/update_download" />
        <com.google.android.material.button.MaterialButton android:id="@+id/update_check" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/update_check" />
        <com.google.android.material.button.MaterialButton android:id="@+id/update_cancel" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/update_cancel" />
    </LinearLayout>
</ScrollView>
