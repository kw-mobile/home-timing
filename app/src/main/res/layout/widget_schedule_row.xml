<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row"
    android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal"
    android:gravity="center_vertical" android:background="@drawable/widget_ripple">
    <TextView android:id="@+id/widget_row_name" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textSize="17sp" android:fontFamily="@font/pretendard"
        android:maxLines="1" android:ellipsize="end" android:textColor="@color/ht_text" />
    <TextView android:id="@+id/widget_row_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:textSize="13sp" android:fontFamily="@font/pretendard_semibold"
        android:textColor="@color/ht_error" android:visibility="gone" />
</LinearLayout>
