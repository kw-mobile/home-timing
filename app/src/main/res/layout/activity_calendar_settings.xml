<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/calendar_settings_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/calendar_back" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/design_001"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/calendar_title" android:textAppearance="@style/TextAppearance.HomeTiming.Brand"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/calendar_help" android:textAppearance="@style/TextAppearance.HomeTiming.Body"/>
        <TextView android:id="@+id/calendar_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="24dp" android:accessibilityLiveRegion="polite" android:textAppearance="@style/TextAppearance.HomeTiming.Body"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/calendar_choose" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/calendar_choose"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/calendar_sync" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/calendar_sync"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/calendar_disable" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/calendar_disable"/>
    </LinearLayout>
</ScrollView>
