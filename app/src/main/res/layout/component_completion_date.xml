<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout android:id="@+id/completion_date_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/component_completion_date" android:textAppearance="@style/TextAppearance.HomeTiming.Label" />
            <TextView android:id="@+id/completion_date_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.HomeTiming.BodyStrong" android:layout_marginTop="4dp" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@drawable/ic_calendar" app:tint="@color/ht_text_secondary" android:importantForAccessibility="no" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/component_completion_date_help" android:textAppearance="@style/TextAppearance.HomeTiming.Caption" android:layout_marginBottom="12dp" />
</merge>
