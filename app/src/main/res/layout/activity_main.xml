<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:paddingHorizontal="@dimen/ht_screen_gutter"
        android:paddingVertical="@dimen/ht_space_12"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/ht_icon"
            android:layout_height="@dimen/ht_icon"
            app:srcCompat="@drawable/ic_brand"
            android:importantForAccessibility="no"
            app:tint="@color/ht_on_primary"
            android:layout_marginEnd="@dimen/ht_space_12" />
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.HomeTiming.Brand" />
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/design_preview"
            android:maxWidth="136dp"
            android:textAppearance="@style/TextAppearance.HomeTiming.Caption"
            android:layout_marginStart="@dimen/ht_space_12"
            android:background="@drawable/bg_hero_pill"
            android:paddingHorizontal="@dimen/ht_space_12"
            android:paddingVertical="@dimen/ht_space_8"
            android:textColor="@color/ht_on_primary_muted" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/screen_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:id="@+id/navigation_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/ht_surface">
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ht_divider" />
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ht_navigation_height"
            android:background="@color/ht_surface"
            android:elevation="0dp"
            app:backgroundTint="@color/ht_surface"
            app:itemIconSize="@dimen/ht_space_24"
            app:itemIconTint="@color/navigation_item"
            app:itemTextColor="@color/navigation_item"
            app:itemTextAppearanceActive="@style/TextAppearance.HomeTiming.Navigation"
            app:itemTextAppearanceInactive="@style/TextAppearance.HomeTiming.Navigation"
            app:itemHorizontalTranslationEnabled="false"
            app:itemPaddingTop="@dimen/ht_space_12"
            app:itemPaddingBottom="@dimen/ht_space_12"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_navigation" />
    </LinearLayout>
</LinearLayout>
