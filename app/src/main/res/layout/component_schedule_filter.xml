<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.HomeTiming.ScheduleRow"
    android:id="@+id/schedule_filter"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:baselineAligned="false">
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="@dimen/ht_space_12"
        android:background="@drawable/bg_icon_container">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:srcCompat="@drawable/ic_filter"
            android:importantForAccessibility="no"
            android:layout_gravity="center"
            app:tint="@color/ht_primary" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/item_filter"
            android:textAppearance="@style/TextAppearance.HomeTiming.BodyStrong" />
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/item_filter_meta"
            android:textAppearance="@style/TextAppearance.HomeTiming.Caption"
            android:layout_marginTop="@dimen/ht_space_4" />
    </LinearLayout>
    <com.google.android.material.textview.MaterialTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_today"
        android:textAppearance="@style/TextAppearance.HomeTiming.CaptionStrong"
        android:layout_marginStart="@dimen/ht_space_8"
        android:layout_gravity="top"
        android:layout_marginTop="3dp"
        android:textColor="@color/ht_primary" />
</LinearLayout>
