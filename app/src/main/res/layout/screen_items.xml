<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/preview_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/hero_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ht_screen_gutter"
            android:paddingTop="@dimen/ht_space_24"
            android:paddingBottom="@dimen/ht_space_32"
            android:id="@+id/hero_content">
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/items_eyebrow"
                android:textAppearance="@style/TextAppearance.HomeTiming.Label"
                android:textColor="@color/ht_on_primary_muted" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/items_title"
                android:textAppearance="@style/TextAppearance.HomeTiming.Display"
                android:layout_marginTop="@dimen/ht_space_12" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/items_hint"
                android:textAppearance="@style/TextAppearance.HomeTiming.Label"
                android:layout_marginTop="@dimen/ht_space_16"
                android:textColor="@color/ht_on_primary_muted" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:id="@+id/preview_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_content_sheet"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="224dp"
        app:behavior_hideable="false"
        app:behavior_fitToContents="true"
        app:behavior_draggable="true">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/sheet_handle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ht_touch_target"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/sheet_expand"
            android:scaleType="center"
            app:srcCompat="@drawable/ic_drag_handle"
            app:tint="@color/ht_text_secondary" />
        <androidx.core.widget.NestedScrollView
            android:id="@+id/preview_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/ht_screen_gutter"
                android:paddingTop="0dp"
                android:paddingBottom="@dimen/ht_space_32">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/items_section"
                    android:textAppearance="@style/TextAppearance.HomeTiming.Title" />
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/items_section_count"
                    android:textAppearance="@style/TextAppearance.HomeTiming.Caption"
                    android:layout_marginTop="@dimen/ht_space_4" />
                <include layout="@layout/component_schedule_filter" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ht_divider" />
                <include layout="@layout/component_schedule_brush" />
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/preview_notice"
                    android:textAppearance="@style/TextAppearance.HomeTiming.Caption"
                    android:layout_marginTop="@dimen/ht_space_24" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
