<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/preview_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/hero_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">
        <LinearLayout
            android:id="@+id/hero_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ht_screen_gutter"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_eyebrow"
                android:textAppearance="@style/TextAppearance.HomeTiming.Caption"
                android:textColor="@color/ht_on_primary_muted" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_title"
                android:textAppearance="@style/TextAppearance.HomeTiming.Display"
                android:id="@+id/page_title"
                android:layout_marginTop="4dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:layout_marginTop="20dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weather_temperature"
                        android:textAppearance="@style/TextAppearance.HomeTiming.Number" />
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weather_location"
                        android:textAppearance="@style/TextAppearance.HomeTiming.Caption"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/ht_on_primary_muted" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/weather_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_sun"
                        app:tint="@color/ht_accent" />
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weather_condition"
                        android:textAppearance="@style/TextAppearance.HomeTiming.Label"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/ht_on_primary" />
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/weather_time"
                        android:text="@string/weather_time_placeholder"
                        android:textAppearance="@style/TextAppearance.HomeTiming.Caption"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/ht_on_primary_muted" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:layout_marginTop="20dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/summary_items"
                        android:textAppearance="@style/TextAppearance.HomeTiming.Caption"
                        android:textColor="@color/ht_on_primary_muted" />
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/summary_items_count"
                        android:textAppearance="@style/TextAppearance.HomeTiming.Title"
                        android:textColor="@color/ht_on_primary"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/summary_chores"
                        android:textAppearance="@style/TextAppearance.HomeTiming.Caption"
                        android:textColor="@color/ht_on_primary_muted" />
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/summary_chores_count"
                        android:textAppearance="@style/TextAppearance.HomeTiming.Title"
                        android:textColor="@color/ht_on_primary"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:id="@+id/preview_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_content_sheet"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="224dp"
        app:behavior_hideable="false"
        app:behavior_fitToContents="true"
        app:behavior_draggable="true">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/sheet_handle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ht_touch_target"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/sheet_expand"
            android:scaleType="center"
            app:srcCompat="@drawable/ic_drag_handle"
            app:tint="@color/ht_text_secondary" />
        <androidx.core.widget.NestedScrollView
            android:id="@+id/preview_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/ht_screen_gutter"
                android:paddingBottom="@dimen/ht_space_32">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/today_heading"
                    android:textAppearance="@style/TextAppearance.HomeTiming.Title"
                    android:id="@+id/section_primary" />
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/today_count"
                    android:textAppearance="@style/TextAppearance.HomeTiming.Caption"
                    android:layout_marginTop="4dp" />
                <include layout="@layout/component_schedule_brush" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ht_divider"
                    android:layout_marginStart="52dp" />
                <include layout="@layout/component_schedule_filter" />
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/next_heading"
                    android:textAppearance="@style/TextAppearance.HomeTiming.Title"
                    android:id="@+id/section_secondary"
                    android:layout_marginTop="24dp" />
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/next_hint"
                    android:textAppearance="@style/TextAppearance.HomeTiming.Caption"
                    android:layout_marginTop="4dp" />
                <include layout="@layout/component_schedule_bedding" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
