<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView android:id="@+id/hero_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/home_hero" android:paddingHorizontal="@dimen/ht_screen_gutter" android:paddingTop="@dimen/ht_space_16" android:paddingBottom="20dp">
            <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/design_028" android:textAppearance="@style/TextAppearance.HomeTiming.Display"/>
            <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/design_029" android:textAppearance="@style/TextAppearance.HomeTiming.Label" android:id="@+id/home_date" android:layout_marginTop="6dp"/>
            <Space android:layout_width="1dp" android:layout_height="20dp"/>
            <include layout="@layout/component_weather"/>
            <Space android:layout_width="1dp" android:layout_height="20dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/preview_sheet" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_content_sheet" android:elevation="2dp" app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior" app:behavior_peekHeight="320dp" app:behavior_hideable="false" app:behavior_fitToContents="true" app:behavior_draggable="true">
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/sheet_handle" android:layout_width="match_parent" android:layout_height="@dimen/ht_touch_target" android:background="?attr/selectableItemBackground" android:contentDescription="@string/design_030" android:scaleType="center" app:srcCompat="@drawable/ic_drag_handle" app:tint="@color/ht_text_secondary"/>
        <androidx.core.widget.NestedScrollView android:id="@+id/preview_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/page_body" android:paddingHorizontal="@dimen/ht_screen_gutter" android:paddingBottom="@dimen/ht_space_32">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/home_rows"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
