rules_version = '2';

// Security rules v2 for docs/DATA_MODEL.md: personal replacement tracking (v1) plus family
// sharing (invites, join, leave, remove, region), account deletion and weekly chores. Anything not
// matched below stays denied. Tests: firestore-rules/ (docs/TESTING.md).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Who is asking ----
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isSelf(userId) { return signedIn() && me() == userId; }

    function userDoc(userId) { return /databases/$(database)/documents/users/$(userId); }
    function houseDoc(houseId) { return /databases/$(database)/documents/houses/$(houseId); }
    function memberDoc(houseId, userId) {
      return /databases/$(database)/documents/houses/$(houseId)/members/$(userId);
    }
    function catalogDoc(houseId, kind) {
      return /databases/$(database)/documents/houses/$(houseId)/categoryCatalogs/$(kind);
    }

    function validCategoryName(name) {
      return isText(name, 30) && name.trim() == name && name != '전체';
    }

    function categoryAssignment(houseId, kind, d) {
      let id = d.get('categoryId', '');
      return id == '' || (isId(id) && existsAfter(catalogDoc(houseId, kind))
          && getAfter(catalogDoc(houseId, kind)).data.labels.get(id, '') == d.category);
    }

    function validCategoryChange(houseId, kind) {
      return !changed().hasAny(['categoryId', 'category'])
          || ((!('categoryId' in resource.data) || 'categoryId' in request.resource.data)
              && categoryAssignment(houseId, kind, request.resource.data));
    }

    function itemDoc(houseId, itemId) {
      return /databases/$(database)/documents/houses/$(houseId)/items/$(itemId);
    }
    function historyDoc(houseId, itemId, occurrenceId) {
      return /databases/$(database)/documents/houses/$(houseId)/items/$(itemId)/history/$(occurrenceId);
    }
    function deletionDoc(uid) { return /databases/$(database)/documents/accountDeletions/$(uid); }
    function activeAccount() { return signedIn() && !existsAfter(deletionDoc(me())); }
    function deletionStarted() { return signedIn() && existsAfter(deletionDoc(me())); }
    function recentAuthentication() {
      return request.auth.token.auth_time is int
          && request.auth.token.auth_time <= request.time.toMillis() / 1000
          && request.auth.token.auth_time > request.time.toMillis() / 1000 - 300;
    }
    function inviteDoc(code) { return /databases/$(database)/documents/invites/$(code); }

    // Six-digit invite code; valid for 24 hours from its server creation time.
    function isInviteCode(v) { return v is string && v.matches('[0-9]{6}'); }
    function inviteLive(invite) { return request.time < invite.createdAt + duration.value(24, 'h'); }

    // Membership is the member document (DATA_MODEL: 소속의 기준).
    function isMember(houseId) { return signedIn() && exists(memberDoc(houseId, me())); }
    function isOwner(houseId) { return signedIn() && get(houseDoc(houseId)).data.ownerId == me(); }

    // ---- Field checks ----
    function hasExactly(data, keys) { return data.keys().hasAll(keys) && data.keys().hasOnly(keys); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Trimmed non-empty text of at most max characters.
    function isText(v, max) { return v is string && v.trim().size() > 0 && v.size() <= max; }
    function optionalText(data, key, max) { return !(key in data) || isText(data[key], max); }
    function isId(v) { return v is string && v.matches('[^/]{1,64}') && v != '.' && v != '..'; }
    function isTarget(v) { return v is string && v.matches('[^/]{1,160}'); }
    function houseReady(houseId) { return get(houseDoc(houseId)).data.integrityVersion == 2; }
    function houseOpen(houseId) {
      return houseReady(houseId) && !get(houseDoc(houseId)).data.get('closing', false);
    }
    function normalWrite(houseId) { return activeAccount() && houseOpen(houseId); }
    function closingOwner(houseId) {
      return signedIn() && houseReady(houseId) && isOwner(houseId)
          && get(houseDoc(houseId)).data.get('closing', false) && deletionStarted();
    }
    function cleanupWrite(houseId) { return normalWrite(houseId) || closingOwner(houseId); }
    function validRecords(d) {
      return d.recordCount is int && d.recordCount >= 0 && d.deleting is bool
          && (!('recordMutationId' in d) || isTarget(d.recordMutationId));
    }
    function sameRecordTarget(a, b) {
      return a.get('recordMutationId', '') == b.get('recordMutationId', '');
    }


    // Product dates are yyyy-MM-dd days in Asia/Seoul.
    function isDate(v) { return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'); }
    function day(d) {
      let p = d.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }
    // Midnight of the date is not later than the current Seoul wall-clock time.
    function notFuture(d) { return day(d) <= request.time + duration.value(9, 'h'); }
    // The date is today or later in Seoul: its end is after the current Seoul wall-clock time.
    function notPast(d) { return day(d) + duration.value(1, 'd') > request.time + duration.value(9, 'h'); }

    // ---- users/{uid}: profile, settings, current house pointer ----
    function isNotifyTime(v) { return v is string && v.matches('([01][0-9]|2[0-3]):[0-5][0-9]'); }
    function isAdvanceDays(v) { return v is int && v >= 0 && v <= 30; }
    // A user may point at a house only when they are its member once the commit lands.
    function memberAfter(houseId) { return isId(houseId) && existsAfter(memberDoc(houseId, me())); }

    // A minimal irreversible receipt survives Auth deletion so other devices and stale tokens
    // cannot interpret the missing user document as a fresh account.
    match /accountDeletions/{userId} {
      allow get: if isSelf(userId);
      allow create: if isSelf(userId) && recentAuthentication()
          && hasExactly(request.resource.data, ['startedAt'])
          && request.resource.data.startedAt == request.time
          && (!exists(userDoc(userId))
              || !exists(memberDoc(get(userDoc(userId)).data.currentHouseId, userId))
              || (get(houseDoc(get(userDoc(userId)).data.currentHouseId)).data.ownerId != userId
                  && !existsAfter(memberDoc(get(userDoc(userId)).data.currentHouseId, userId))
                  && !existsAfter(userDoc(userId)))
              || (get(houseDoc(get(userDoc(userId)).data.currentHouseId)).data.ownerId == userId
                  && get(houseDoc(get(userDoc(userId)).data.currentHouseId)).data.memberCount == 1
                  && getAfter(houseDoc(get(userDoc(userId)).data.currentHouseId)).data.get('closing', false)));
      // No client update/delete, including after a failed deletion. Retry cleanup instead.
    }

    match /users/{userId} {
      allow get: if isSelf(userId);

      // First sign-in: committed together with a new house and member (AuthRepository).
      allow create: if isSelf(userId) && activeAccount()
          && hasExactly(request.resource.data,
              ['currentHouseId', 'displayName', 'notifyTime', 'advanceDays', 'createdAt', 'updatedAt'])
          && isText(request.resource.data.displayName, 20)
          && isNotifyTime(request.resource.data.notifyTime)
          && isAdvanceDays(request.resource.data.advanceDays)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && memberAfter(request.resource.data.currentHouseId);

      allow update: if isSelf(userId) && activeAccount()
          && request.resource.data.updatedAt == request.time
          && (
            // Personal notification settings.
            (changed().hasOnly(['notifyTime', 'advanceDays', 'updatedAt'])
                && isNotifyTime(request.resource.data.notifyTime)
                && isAdvanceDays(request.resource.data.advanceDays))
            // Moving to another house (recovery, joining, leaving) needs membership there.
            || (changed().hasOnly(['currentHouseId', 'updatedAt'])
                && memberAfter(request.resource.data.currentHouseId)
                && (request.resource.data.currentHouseId == resource.data.currentHouseId
                    || !existsAfter(memberDoc(resource.data.currentHouseId, me()))))
          );

      // Account deletion: the user leaves (or dissolves) their current house in the same commit,
      // so no member document points at a deleted user. Auth is deleted afterwards by the app.
      allow delete: if isSelf(userId) && deletionStarted()
          && !existsAfter(memberDoc(resource.data.currentHouseId, me()));
    }

    function lookupDoc(uid) { return /databases/$(database)/documents/inviteLookups/$(uid); }
    function freshInviteAccess(code, purpose) {
      let access = get(lookupDoc(me())).data;
      return exists(lookupDoc(me())) && access.code == code && access.purpose == purpose
          && access.updatedAt <= request.time && request.time < access.updatedAt + duration.value(10, 's');
    }
    function readsOwnActiveInvite(code) {
      let houseId = get(userDoc(me())).data.currentHouseId;
      let home = get(houseDoc(houseId)).data;
      return home.ownerId == me() && home.get('activeInviteCode', '') == code;
    }
    match /inviteLookups/{userId} {
      function validAccess() {
        let next = request.resource.data;
        return hasExactly(next, ['code', 'purpose', 'windowStartedAt', 'attempts', 'updatedAt'])
            && isInviteCode(next.code) && next.purpose in ['LOOKUP', 'ISSUE']
            && next.attempts is int && next.attempts >= 1 && next.attempts <= 10
            && next.updatedAt == request.time;
      }
      allow get: if isSelf(userId);
      allow create: if isSelf(userId) && activeAccount() && validAccess()
          && request.resource.data.attempts == 1 && request.resource.data.windowStartedAt == request.time;
      allow update: if isSelf(userId) && activeAccount() && validAccess()
          && (request.time >= resource.data.windowStartedAt + duration.value(60, 's')
              ? (request.resource.data.attempts == 1 && request.resource.data.windowStartedAt == request.time)
              : (request.resource.data.windowStartedAt == resource.data.windowStartedAt
                  && request.resource.data.attempts == resource.data.attempts + 1));
      allow delete: if isSelf(userId) && deletionStarted();
    }

    // ---- invites/{code}: outside houses so non-members can join without reading the house ----
    match /invites/{code} {
      // Anyone signed in may look up a code they were given; listing codes is denied.
      allow get: if signedIn() && !exists(deletionDoc(me()))
          && (freshInviteAccess(code, 'LOOKUP') || freshInviteAccess(code, 'ISSUE') || readsOwnActiveInvite(code));

      // The owner issues a code for their house and makes it the house's active code in the same
      // commit. Expiry is createdAt + 24 h, so clients never write the expiry themselves.
      function isIssue() {
        let data = request.resource.data;
        return activeAccount()
            && houseOpen(data.houseId)
            && isInviteCode(code) && freshInviteAccess(code, 'ISSUE')
            && hasExactly(data, ['houseId', 'createdBy', 'createdAt'])
            && isId(data.houseId)
            && data.createdBy == me()
            && houseReady(data.houseId)
            && get(houseDoc(data.houseId)).data.ownerId == me()
            && data.createdAt == request.time
            && getAfter(houseDoc(data.houseId)).data.activeInviteCode == code;
      }

      allow create: if isIssue();
      // A code still live for any house is never overwritten; an expired one may be reused.
      allow update: if isIssue() && !inviteLive(resource.data);
      // The owner of the invite's house removes it (reissue, stop, or dissolving that house).
      allow delete: if signedIn()
          && (normalWrite(resource.data.houseId)
              || (isOwner(resource.data.houseId) && houseReady(resource.data.houseId)
                  && getAfter(houseDoc(resource.data.houseId)).data.get('closing', false) && deletionStarted()))
          && get(houseDoc(resource.data.houseId)).data.ownerId == me();
    }

    // ---- houses/{houseId} ----
    match /houses/{houseId} {
      allow get: if isMember(houseId);

      // Only a one-person, empty house owned by the caller, founded with its member document
      // and with the caller's user document pointing at it.
      allow create: if activeAccount()
          && hasExactly(request.resource.data,
              ['ownerId', 'memberCount', 'itemCount', 'choreCount', 'integrityVersion', 'closing', 'createdAt', 'updatedAt'])
          && request.resource.data.ownerId == me()
          && request.resource.data.integrityVersion == 2
          && request.resource.data.closing == false
          && request.resource.data.memberCount == 1
          && request.resource.data.itemCount == 0
          && request.resource.data.choreCount == 0
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && existsAfter(memberDoc(houseId, me()))
          && getAfter(userDoc(me())).data.currentHouseId == houseId;

      // Both the count holder and target document validate this binding, so one delta
      // cannot authorize several creations/deletions or a count-only write.
      function countMutation(collection, countField, targetField) {
        let id = request.resource.data[targetField];
        let target = /databases/$(database)/documents/houses/$(houseId)/$(collection)/$(id);
        return isTarget(id) && changed().hasOnly([countField, targetField])
            && request.resource.data[countField] is int && request.resource.data[countField] >= 0
            && ((request.resource.data[countField] == resource.data[countField] + 1
                    && !exists(target) && existsAfter(target))
                || (request.resource.data[countField] == resource.data[countField] - 1
                    && exists(target) && !existsAfter(target)));
      }

      function memberMutation() {
        let id = request.resource.data.memberMutationId;
        let target = memberDoc(houseId, id);
        return isTarget(id) && changed().hasOnly(['memberCount', 'memberMutationId'])
            && request.resource.data.memberCount is int
            && request.resource.data.memberCount >= 1 && request.resource.data.memberCount <= 6
            && ((request.resource.data.memberCount == resource.data.memberCount + 1
                    && id == me() && !exists(target) && existsAfter(target))
                || (request.resource.data.memberCount == resource.data.memberCount - 1
                    && (id == me() || resource.data.ownerId == me())
                    && id != resource.data.ownerId && exists(target) && !existsAfter(target)));
      }

      function isNormalMutation() {
        return normalWrite(houseId) && (
          (isMember(houseId) && countMutation('items', 'itemCount', 'itemMutationId'))
          || (isMember(houseId) && countMutation('chores', 'choreCount', 'choreMutationId'))
          || memberMutation()
          // Invite: the owner points at an invite for this house, or stops inviting.
          || (resource.data.ownerId == me()
              && changed().hasOnly(['activeInviteCode'])
              && (!('activeInviteCode' in request.resource.data)
                  || (isInviteCode(request.resource.data.activeInviteCode)
                      && getAfter(inviteDoc(request.resource.data.activeInviteCode)).data.houseId == houseId)))
          // Region (F-08): the owner sets the area and its forecast grid.
          || (resource.data.ownerId == me()
              && changed().hasOnly(['regionName', 'nx', 'ny'])
              && isText(request.resource.data.regionName, 30)
              && request.resource.data.nx is int && request.resource.data.nx >= 1 && request.resource.data.nx <= 149
              && request.resource.data.ny is int && request.resource.data.ny >= 1 && request.resource.data.ny <= 253)
      );
      }

      function isClosingStart() {
        return resource.data.ownerId == me() && !resource.data.get('closing', false)
            && request.resource.data.closing == true && resource.data.memberCount == 1
            && deletionStarted() && !('activeInviteCode' in request.resource.data)
            && changed().hasOnly(['closing', 'activeInviteCode', 'updatedAt'])
            && request.resource.data.updatedAt == request.time;
      }
      function isClosingCleanup() {
        return closingOwner(houseId) && (
            (countMutation('items', 'itemCount', 'itemMutationId')
                && request.resource.data.itemCount == resource.data.itemCount - 1)
            || (countMutation('chores', 'choreCount', 'choreMutationId')
                && request.resource.data.choreCount == resource.data.choreCount - 1));
      }
      function isMemberAccountDeletion() {
        return houseOpen(houseId) && deletionStarted() && memberMutation()
            && request.resource.data.memberMutationId == me()
            && request.resource.data.memberCount == resource.data.memberCount - 1
            && !existsAfter(userDoc(me()));
      }
      allow update: if signedIn() && houseReady(houseId)
          && (isNormalMutation() || isClosingStart() || isClosingCleanup() || isMemberAccountDeletion());

      // The owner dissolves their own empty one-person house while moving elsewhere (joining) or
      // deleting their account (the user document goes in the same commit).
      allow delete: if isOwner(houseId) && cleanupWrite(houseId)
          && resource.data.memberCount == 1
          && resource.data.itemCount == 0
          && resource.data.choreCount == 0
          && !existsAfter(memberDoc(houseId, me()))
          && !existsAfter(catalogDoc(houseId, 'item'))
          && !existsAfter(catalogDoc(houseId, 'chore'))
          && (!existsAfter(userDoc(me())) || getAfter(userDoc(me())).data.currentHouseId != houseId);

      // Exactly two known catalogs. Immutable redirects resolve old records without changing history.
      match /categoryCatalogs/{kind} {
        function knownKind() { return kind in ['item', 'chore']; }

        function defaults() {
          return kind == 'item'
              ? {'default_bathroom': '욕실', 'default_kitchen': '주방', 'default_other': '기타'}
              : {'default_bedding': '세탁', 'default_dry': '건조', 'default_ventilation': '환기',
                 'default_cleaning': '청소', 'default_other': '기타'};
        }

        function validCatalog(d) {
          return hasExactly(d, ['labels', 'redirects', 'revision', 'operation', 'source',
                  'target', 'updatedBy', 'updatedAt'])
              && d.labels is map && d.redirects is map
              && d.labels.size() >= 1 && d.labels.size() + d.redirects.size() <= 1000
              && d.revision is int && d.revision >= 1
              && d.operation in ['INIT', 'ADD', 'RENAME', 'DELETE', 'ALIAS']
              && d.source is string && d.source.size() <= 64
              && d.target is string && d.target.size() <= 64
              && d.updatedBy == me() && d.updatedAt == request.time;
        }

        function applyCatalogChange(d, before) {
          let id = d.source;
          let labels = d.labels.diff(before.labels);
          let redirects = d.redirects.diff(before.redirects);
          let newId = !(id in before.labels) && !(id in before.redirects);
          let unique = d.labels.values().toSet().size() == d.labels.size();
          return d.revision == before.revision + 1 && unique
              && ((d.operation == 'ADD' && newId && d.target == ''
                      && id.matches('(c_|legacy_)[0-9a-f]{32}')
                      && labels.addedKeys() == [id].toSet()
                      && labels.affectedKeys().hasOnly([id]) && redirects.affectedKeys().size() == 0
                      && validCategoryName(d.labels[id]))
                  || (d.operation == 'RENAME' && id in before.labels && d.target == ''
                      && labels.changedKeys() == [id].toSet()
                      && labels.affectedKeys().hasOnly([id]) && redirects.affectedKeys().size() == 0
                      && validCategoryName(d.labels[id]))
                  || (d.operation == 'DELETE' && id in before.labels && d.target in d.labels
                      && labels.removedKeys() == [id].toSet() && labels.affectedKeys().hasOnly([id])
                      && redirects.addedKeys() == [id].toSet() && redirects.affectedKeys().hasOnly([id])
                      && d.redirects[id] == d.target)
                  || (d.operation == 'ALIAS' && newId && id.matches('legacy_[0-9a-f]{32}')
                      && d.target in d.labels && labels.affectedKeys().size() == 0
                      && redirects.addedKeys() == [id].toSet() && redirects.affectedKeys().hasOnly([id])
                      && d.redirects[id] == d.target));
        }

        allow get: if knownKind() && isMember(houseId);
        allow create: if knownKind() && isMember(houseId) && normalWrite(houseId)
            && validCatalog(request.resource.data)
            && request.resource.data.operation == 'INIT' && request.resource.data.revision == 1
            && request.resource.data.source == '' && request.resource.data.target == ''
            && request.resource.data.labels == defaults() && request.resource.data.redirects.size() == 0;
        allow update: if knownKind() && isMember(houseId) && normalWrite(houseId)
            && validCatalog(request.resource.data)
            && applyCatalogChange(request.resource.data, resource.data);
        allow delete: if knownKind() && isOwner(houseId) && cleanupWrite(houseId)
            && !existsAfter(houseDoc(houseId));
      }

      // ---- members/{uid} ----
      match /members/{memberId} {
        // A removed user can still read their own (missing) member document to recover.
        allow get: if isSelf(memberId) || isMember(houseId);
        allow list: if isMember(houseId);

        // Founding a new house (first sign-in, recovery, leaving).
        function isFounding() {
          return !exists(houseDoc(houseId))
              && getAfter(houseDoc(houseId)).data.integrityVersion == 2
              && getAfter(houseDoc(houseId)).data.ownerId == me()
              && hasExactly(request.resource.data, ['displayName', 'joinedAt'])
              && request.resource.data.displayName == getAfter(userDoc(me())).data.displayName;
        }

        // Joining with a live invite that is the house's active one, into a house with room, while
        // the caller's empty one-person house is deleted in the same commit (docs/DATA_MODEL.md).
        function isJoining() {
          let data = request.resource.data;
          let house = get(houseDoc(houseId)).data;
          let previousHouse = get(userDoc(me())).data.currentHouseId;
          return exists(houseDoc(houseId)) && normalWrite(houseId)
              && getAfter(houseDoc(houseId)).data.memberMutationId == me()
              && hasExactly(data, ['displayName', 'joinedAt', 'inviteCode'])
              && isInviteCode(data.inviteCode) && freshInviteAccess(data.inviteCode, 'LOOKUP')
              && house.activeInviteCode == data.inviteCode
              && get(inviteDoc(data.inviteCode)).data.houseId == houseId
              && inviteLive(get(inviteDoc(data.inviteCode)).data)
              && house.memberCount < 6
              && getAfter(houseDoc(houseId)).data.memberCount == house.memberCount + 1
              && data.displayName == get(userDoc(me())).data.displayName
              && previousHouse != houseId
              && !existsAfter(houseDoc(previousHouse))
              && getAfter(userDoc(me())).data.currentHouseId == houseId;
        }

        allow create: if isSelf(memberId) && activeAccount()
            && isText(request.resource.data.displayName, 20)
            && request.resource.data.joinedAt == request.time
            && (isFounding() || isJoining());

        function houseCountDropsByOne() {
          return houseReady(houseId)
              && getAfter(houseDoc(houseId)).data.memberMutationId == memberId
              && getAfter(houseDoc(houseId)).data.memberCount == get(houseDoc(houseId)).data.memberCount - 1;
        }

        allow delete: if signedIn() && (cleanupWrite(houseId)
            || (houseOpen(houseId) && deletionStarted() && isSelf(memberId) && !existsAfter(userDoc(me())))) && (
            // Leaving: a non-owner removes themself.
            (isSelf(memberId) && get(houseDoc(houseId)).data.ownerId != me() && houseCountDropsByOne())
            // Dissolving: the owner removes themself while deleting the house in the same commit.
            || (isSelf(memberId) && get(houseDoc(houseId)).data.ownerId == me() && !existsAfter(houseDoc(houseId)))
            // Removing: the owner removes another member.
            || (isOwner(houseId) && memberId != me() && houseCountDropsByOne())
        );
      }

      // ---- items/{itemId} ----
      match /items/{itemId} {
        function validItem(d) {
          return d.keys().hasAll(['name', 'category', 'startDate', 'cycleDays', 'lastReplacedDate',
                  'nextDueDate', 'occurrenceId', 'revision', 'createdBy', 'updatedBy',
                  'createdAt', 'updatedAt', 'recordCount', 'deleting'])
              && d.keys().hasOnly(['name', 'category', 'startDate', 'cycleDays', 'lastReplacedDate',
                  'nextDueDate', 'occurrenceId', 'revision', 'createdBy', 'updatedBy',
                  'createdAt', 'updatedAt', 'recordCount', 'deleting', 'recordMutationId', 'productName', 'location', 'memo', 'categoryId'])
              && validRecords(d)
              && isText(d.name, 60)
              && isText(d.category, 30)
              && (!('categoryId' in d) || isId(d.categoryId))
              && isDate(d.startDate) && notFuture(d.startDate)
              && d.cycleDays is int && d.cycleDays >= 1 && d.cycleDays <= 730
              && isDate(d.lastReplacedDate) && notFuture(d.lastReplacedDate)
              && d.lastReplacedDate >= d.startDate
              && isDate(d.nextDueDate)
              && day(d.nextDueDate) == day(d.lastReplacedDate) + duration.value(d.cycleDays, 'd')
              && isId(d.occurrenceId)
              && d.revision is int
              && optionalText(d, 'productName', 60)
              && optionalText(d, 'location', 30)
              && optionalText(d, 'memo', 500)
              && d.updatedBy == me()
              && d.updatedAt == request.time;
        }

        function itemCountAfterIs(delta) {
          return houseReady(houseId) && getAfter(houseDoc(houseId)).data.itemMutationId == itemId
              && getAfter(houseDoc(houseId)).data.itemCount == get(houseDoc(houseId)).data.itemCount + delta;
        }

        // Edit (F-03): same occurrence; revision +1 exactly when schedule fields change.
        function isEdit() {
          let next = request.resource.data;
          return !resource.data.deleting && !next.deleting
              && next.recordCount == resource.data.recordCount && sameRecordTarget(next, resource.data)
              && (resource.data.recordCount > 0
                  ? next.lastReplacedDate == resource.data.lastReplacedDate
                  : next.lastReplacedDate == next.startDate)
              && next.occurrenceId == resource.data.occurrenceId
              && next.revision == resource.data.revision
                  + (changed().hasAny(['startDate', 'cycleDays', 'lastReplacedDate', 'nextDueDate']) ? 1 : 0);
        }

        // Completion (F-05): a new occurrence, the history of the finished one created in the same
        // commit (once only), and an actual date not before the previous one (#20).
        function isCompletion() {
          let next = request.resource.data;
          let finished = resource.data.occurrenceId;
          return changed().hasOnly(['lastReplacedDate', 'nextDueDate', 'occurrenceId', 'revision',
                  'updatedBy', 'updatedAt', 'recordCount', 'recordMutationId'])
              && !resource.data.deleting && !next.deleting
              && next.recordCount == resource.data.recordCount + 1 && next.recordMutationId == finished
              && next.occurrenceId != finished
              && !exists(historyDoc(houseId, itemId, next.occurrenceId))
              && !existsAfter(historyDoc(houseId, itemId, next.occurrenceId))
              && next.revision == resource.data.revision + 1
              && next.lastReplacedDate >= resource.data.lastReplacedDate
              && !exists(historyDoc(houseId, itemId, finished))
              && existsAfter(historyDoc(houseId, itemId, finished));
        }

        function canDelete() { return resource.data.createdBy == me() || isOwner(houseId); }

        function isDeletionStep() {
          let old = resource.data;
          let next = request.resource.data;
          let id = next.get('recordMutationId', '_');
          let record = /databases/$(database)/documents/houses/$(houseId)/items/$(itemId)/history/$(id);
          return canDelete() && next.deleting
              && ((!old.deleting && next.recordCount == old.recordCount && sameRecordTarget(next, old)
                      && changed().hasOnly(['deleting', 'updatedBy', 'updatedAt']))
                  || (old.deleting && isTarget(id) && next.recordCount == old.recordCount - 1
                      && changed().hasOnly(['recordCount', 'recordMutationId', 'updatedBy', 'updatedAt'])
                      && exists(record) && !existsAfter(record)));
        }

        allow read: if isMember(houseId);

        allow create: if isMember(houseId) && normalWrite(houseId)
            && validItem(request.resource.data)
            && categoryAssignment(houseId, 'item', request.resource.data)
            && request.resource.data.createdBy == me()
            && request.resource.data.createdAt == request.time
            && request.resource.data.revision == 1
            && request.resource.data.recordCount == 0 && request.resource.data.deleting == false
            && !('recordMutationId' in request.resource.data)
            && request.resource.data.lastReplacedDate == request.resource.data.startDate
            && itemCountAfterIs(1);

        allow update: if isMember(houseId) && cleanupWrite(houseId)
            && validRecords(resource.data)
            && validItem(request.resource.data)
            && validCategoryChange(houseId, 'item')
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && ((normalWrite(houseId) && (isEdit() || isCompletion())) || isDeletionStep());

        // Registrant or owner (MVP). History is deleted in the same or earlier commits.
        allow delete: if isMember(houseId) && cleanupWrite(houseId)
            && resource.data.deleting && resource.data.recordCount == 0
            && (resource.data.createdBy == me() || isOwner(houseId))
            && itemCountAfterIs(-1);

        // ---- items/{itemId}/history/{occurrenceId} ----
        match /history/{occurrenceId} {
          allow read: if isMember(houseId);

          allow create: if isMember(houseId) && normalWrite(houseId)
              && !get(itemDoc(houseId, itemId)).data.deleting
              && !getAfter(itemDoc(houseId, itemId)).data.deleting
              && getAfter(itemDoc(houseId, itemId)).data.recordCount == get(itemDoc(houseId, itemId)).data.recordCount + 1
              && getAfter(itemDoc(houseId, itemId)).data.recordMutationId == occurrenceId
              && get(itemDoc(houseId, itemId)).data.occurrenceId == occurrenceId
              && getAfter(itemDoc(houseId, itemId)).data.occurrenceId != occurrenceId
              && hasExactly(request.resource.data,
                  ['replacedDate', 'previousDueDate', 'cycleDaysUsed', 'completedBy',
                   'completedByName', 'createdAt'])
              && request.resource.data.replacedDate == getAfter(itemDoc(houseId, itemId)).data.lastReplacedDate
              && request.resource.data.previousDueDate == get(itemDoc(houseId, itemId)).data.nextDueDate
              && request.resource.data.cycleDaysUsed == get(itemDoc(houseId, itemId)).data.cycleDays
              && request.resource.data.completedBy == me()
              && request.resource.data.completedByName == get(memberDoc(houseId, me())).data.displayName
              && request.resource.data.createdAt == request.time;

          // Removed only while deleting the item, by those who may delete it.
          allow delete: if isMember(houseId) && cleanupWrite(houseId)
              && get(itemDoc(houseId, itemId)).data.deleting && getAfter(itemDoc(houseId, itemId)).data.deleting
              && getAfter(itemDoc(houseId, itemId)).data.recordCount == get(itemDoc(houseId, itemId)).data.recordCount - 1
              && getAfter(itemDoc(houseId, itemId)).data.recordMutationId == occurrenceId
              && (get(itemDoc(houseId, itemId)).data.createdBy == me() || isOwner(houseId));
        }
      }

      // ---- chores/{choreId}: weekly chores ----
      match /chores/{choreId} {
        function choreDoc() {
          return /databases/$(database)/documents/houses/$(houseId)/chores/$(choreId);
        }
        function logDoc(logId) {
          return /databases/$(database)/documents/houses/$(houseId)/chores/$(choreId)/logs/$(logId);
        }

        function validChore(d) {
          return d.keys().hasAll(['name', 'type', 'weatherSensitive', 'weekday', 'plannedDueDate',
                  'nextDueDate', 'occurrenceId', 'revision', 'createdBy', 'updatedBy',
                  'createdAt', 'updatedAt', 'recordCount', 'deleting'])
              && d.keys().hasOnly(['name', 'type', 'weatherSensitive', 'weekday', 'plannedDueDate',
                  'nextDueDate', 'occurrenceId', 'revision', 'createdBy', 'updatedBy',
                  'createdAt', 'updatedAt', 'recordCount', 'deleting', 'recordMutationId', 'dismissedOccurrenceId', 'lastDoneDate', 'location', 'memo', 'categoryId', 'category'])
              && validRecords(d)
              && isText(d.name, 60)
              && d.type in ['BEDDING_WASH', 'OUTDOOR_DRY', 'VENTILATION', 'CLEANING', 'ETC']
              && (('categoryId' in d) == ('category' in d))
              && (!('categoryId' in d) || (isId(d.categoryId) && validCategoryName(d.category)))
              && d.weatherSensitive is bool
              && d.weekday is int && d.weekday >= 1 && d.weekday <= 7
              && isDate(d.plannedDueDate)
              && isDate(d.nextDueDate)
              && isId(d.occurrenceId)
              && d.revision is int
              && (!('dismissedOccurrenceId' in d) || d.dismissedOccurrenceId == d.occurrenceId)
              && (!('lastDoneDate' in d) || (isDate(d.lastDoneDate) && notFuture(d.lastDoneDate)))
              && optionalText(d, 'location', 30)
              && optionalText(d, 'memo', 500)
              && d.updatedBy == me()
              && d.updatedAt == request.time;
        }

        function onWeekday(d, weekday) { return day(d).dayOfWeek() == weekday; }

        function choreCountAfterIs(delta) {
          return houseReady(houseId) && getAfter(houseDoc(houseId)).data.choreMutationId == choreId
              && getAfter(houseDoc(houseId)).data.choreCount == get(houseDoc(houseId)).data.choreCount + delta;
        }

        // Same occurrence: an edit, moving this occurrence, or dismissing its suggestion. Revision
        // +1 exactly when schedule or suggestion fields change.
        function isSameOccurrence() {
          let next = request.resource.data;
          let old = resource.data;
          return !old.deleting && !next.deleting
              && (next.weekday == old.weekday && next.nextDueDate != old.nextDueDate
                  ? (next.recordCount == old.recordCount + 1
                      && next.recordMutationId == 'moved_' + next.occurrenceId + '_' + string(next.revision))
                  : (next.recordCount == old.recordCount && sameRecordTarget(next, old)))
              && next.occurrenceId == old.occurrenceId
              && !changed().hasAny(['lastDoneDate'])
              && next.revision == old.revision
                  + (changed().hasAny(['weekday', 'plannedDueDate', 'nextDueDate', 'weatherSensitive',
                      'dismissedOccurrenceId']) ? 1 : 0)
              && (next.weekday != old.weekday
                  // A new weekday restarts this occurrence on that weekday.
                  ? (next.plannedDueDate == next.nextDueDate
                      && onWeekday(next.plannedDueDate, next.weekday)
                      && notPast(next.plannedDueDate))
                  // Otherwise the original date stays; moving needs today or later and its log.
                  : (next.plannedDueDate == old.plannedDueDate
                      && (next.nextDueDate == old.nextDueDate
                          || (notPast(next.nextDueDate)
                              && !exists(logDoc('moved_' + next.occurrenceId + '_' + string(next.revision)))
                              && existsAfter(logDoc('moved_' + next.occurrenceId + '_' + string(next.revision)))))));
        }

        // Completion: a new occurrence on the first original weekday after the done date, from
        // the week after the original date, with the finished occurrence's log (once only).
        function isCompletion() {
          let next = request.resource.data;
          let old = resource.data;
          let planned = day(next.plannedDueDate);
          let previous = day(old.plannedDueDate);
          let done = day(next.lastDoneDate);
          return changed().hasOnly(['plannedDueDate', 'nextDueDate', 'occurrenceId', 'revision',
                  'lastDoneDate', 'dismissedOccurrenceId', 'updatedBy', 'updatedAt', 'recordCount', 'recordMutationId'])
              && !old.deleting && !next.deleting
              && next.recordCount == old.recordCount + 1
              && next.recordMutationId == 'done_' + old.occurrenceId
              && next.occurrenceId != old.occurrenceId
              && !exists(logDoc('done_' + next.occurrenceId))
              && !existsAfter(logDoc('done_' + next.occurrenceId))
              && next.revision == old.revision + 1
              && next.plannedDueDate == next.nextDueDate
              && planned > previous
              && planned > done
              && (planned - previous).seconds() % 604800 == 0
              && (planned - duration.value(7, 'd') <= done || planned - duration.value(7, 'd') == previous)
              && !exists(logDoc('done_' + old.occurrenceId))
              && existsAfter(logDoc('done_' + old.occurrenceId));
        }

        function canDelete() { return resource.data.createdBy == me() || isOwner(houseId); }

        function isDeletionStep() {
          let old = resource.data;
          let next = request.resource.data;
          let id = next.get('recordMutationId', '_');
          let record = /databases/$(database)/documents/houses/$(houseId)/chores/$(choreId)/logs/$(id);
          return canDelete() && next.deleting
              && ((!old.deleting && next.recordCount == old.recordCount && sameRecordTarget(next, old)
                      && changed().hasOnly(['deleting', 'updatedBy', 'updatedAt']))
                  || (old.deleting && isTarget(id) && next.recordCount == old.recordCount - 1
                      && changed().hasOnly(['recordCount', 'recordMutationId', 'updatedBy', 'updatedAt'])
                      && exists(record) && !existsAfter(record)));
        }

        allow read: if isMember(houseId);

        allow create: if isMember(houseId) && normalWrite(houseId)
            && validChore(request.resource.data)
            && categoryAssignment(houseId, 'chore', request.resource.data)
            && request.resource.data.createdBy == me()
            && request.resource.data.createdAt == request.time
            && request.resource.data.revision == 1
            && request.resource.data.recordCount == 0 && request.resource.data.deleting == false
            && !('recordMutationId' in request.resource.data)
            && request.resource.data.plannedDueDate == request.resource.data.nextDueDate
            && onWeekday(request.resource.data.plannedDueDate, request.resource.data.weekday)
            && !('dismissedOccurrenceId' in request.resource.data)
            && !('lastDoneDate' in request.resource.data)
            && choreCountAfterIs(1);

        allow update: if isMember(houseId) && cleanupWrite(houseId)
            && validRecords(resource.data)
            && validChore(request.resource.data)
            && validCategoryChange(houseId, 'chore')
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && ((normalWrite(houseId) && (isSameOccurrence() || isCompletion())) || isDeletionStep());

        // Registrant or owner, like items. Logs are deleted in the same or earlier commits.
        allow delete: if isMember(houseId) && cleanupWrite(houseId)
            && resource.data.deleting && resource.data.recordCount == 0
            && (resource.data.createdBy == me() || isOwner(houseId))
            && choreCountAfterIs(-1);

        // ---- chores/{choreId}/logs/{logId} ----
        match /logs/{logId} {
          function isDoneLog(data) {
            let before = get(choreDoc()).data;
            let after = getAfter(choreDoc()).data;
            return data.action == 'DONE'
                && logId == 'done_' + before.occurrenceId
                && data.occurrenceId == before.occurrenceId
                && after.occurrenceId != before.occurrenceId
                && data.date == after.lastDoneDate
                && hasExactly(data, ['action', 'occurrenceId', 'date', 'actorId', 'actorName', 'createdAt']);
          }

          function isMovedLog(data) {
            let before = get(choreDoc()).data;
            let after = getAfter(choreDoc()).data;
            return data.action == 'RESCHEDULED'
                && logId == 'moved_' + after.occurrenceId + '_' + string(after.revision)
                && data.occurrenceId == before.occurrenceId
                && after.occurrenceId == before.occurrenceId
                && data.date == after.nextDueDate
                && data.fromDate == before.nextDueDate
                && data.reason in ['RAIN_FORECAST', 'USER']
                && hasExactly(data, ['action', 'occurrenceId', 'date', 'fromDate', 'reason', 'actorId',
                    'actorName', 'createdAt']);
          }

          allow read: if isMember(houseId);

          allow create: if isMember(houseId) && normalWrite(houseId)
              && !get(choreDoc()).data.deleting && !getAfter(choreDoc()).data.deleting
              && getAfter(choreDoc()).data.recordCount == get(choreDoc()).data.recordCount + 1
              && getAfter(choreDoc()).data.recordMutationId == logId
              && request.resource.data.actorId == me()
              && request.resource.data.actorName == get(memberDoc(houseId, me())).data.displayName
              && request.resource.data.createdAt == request.time
              && (isDoneLog(request.resource.data) || isMovedLog(request.resource.data));

          // Removed only while deleting the chore, by those who may delete it.
          allow delete: if isMember(houseId) && cleanupWrite(houseId)
              && get(choreDoc()).data.deleting && getAfter(choreDoc()).data.deleting
              && getAfter(choreDoc()).data.recordCount == get(choreDoc()).data.recordCount - 1
              && getAfter(choreDoc()).data.recordMutationId == logId
              && (get(choreDoc()).data.createdBy == me() || isOwner(houseId));
        }
      }
    }
  }
}
